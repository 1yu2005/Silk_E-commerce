# 仅供本地开发使用。复制到 .env 后替换示例密码。
# 环境变量优先于本文件，不支持 ${...} 变量插值。
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shop:replace-with-local-password@localhost:15432/shop_dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true
LOG_LEVEL=info
# 省略时使用项目根目录下 storage/uploads 的绝对路径。
# 在 Windows 上覆盖时请使用绝对路径，例如 D:/shop-storage/uploads。
# UPLOAD_DIR=
# 文件未绑定配额（含尚未被清理的过期STAGED）、每主体每分钟上传次数、清理批次间隔。
# 省略即可使用默认值，无须修改已有真实.env；单实例内存限流，配额由数据库主体锁保证。
FILE_STAGED_QUOTA=100
FILE_UPLOADS_PER_MINUTE=20
FILE_CLEANUP_INTERVAL_SECONDS=300

# Compose 数据库配置及独立的集成测试数据库。
POSTGRES_DB=shop_dev
DB_HOST_PORT=15432
API_HOST_PORT=3000
ADMIN_HOST_PORT=8080
STORE_HOST_PORT=8081
COMPOSE_CORS_ORIGINS=http://localhost:8080,http://localhost:8081
POSTGRES_USER=shop
POSTGRES_PASSWORD=replace-with-local-password
TEST_DATABASE_URL=postgresql://shop:replace-with-local-password@localhost:15432/shop_test

# 后端JWT模块配置；密钥必须自行生成至少32字节随机值，无可用默认密钥。
# API已接入员工认证，启动及OpenAPI导出必须配置；不可作为VITE_*变量传入前端。
JWT_SECRET=
JWT_TTL_SECONDS=7200

# 仅显式执行db:seed:admin时读取；省略时也默认admin/admin123，可自行覆盖。
# 首管理员无需强制改密；重复seed不会重置密码、角色、状态或授权。
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# 这里只放公开配置，禁止填写数据库密码或 JWT 密钥。
VITE_API_BASE_URL=/api/v1
