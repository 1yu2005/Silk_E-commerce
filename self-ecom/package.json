{
  "name": "self-ecom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "openapi:export": "pnpm --filter @shop/api openapi:export",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @shop/api db:generate",
    "db:migrate:dev": "pnpm --filter @shop/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @shop/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @shop/api db:migrate:status",
    "db:test:prepare": "pnpm --filter @shop/api db:test:prepare",
    "test:integration": "pnpm --filter @shop/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
