# 作用：复制为私有.env.restore后填值；必须使用全新项目、数据库、四端口及卷。
# 不覆盖根.env。运维CLI仅解析显式env-file；不会从根.env继承业务配置。
RESTORE_PROJECT=shop-restore-check
RESTORE_DATABASE_NAME=m415_restore_check
POSTGRES_DB=m415_restore_check
POSTGRES_USER=restore_operator
POSTGRES_PASSWORD=replace_with_uri_safe_random_secret
JWT_SECRET=replace_with_at_least_32_random_bytes
DB_HOST_PORT=35432
API_HOST_PORT=33001
ADMIN_HOST_PORT=38080
STORE_HOST_PORT=38081
SWAGGER_ENABLED=true
LOG_LEVEL=info
JWT_TTL_SECONDS=7200
# verify:reconcile独立CLI还需以下显式隔离确认；DATABASE_URL/UPLOAD_DIR仅在私有文件配置。
ISOLATED_TARGET=restore
ISOLATED_DATABASE_NAME=m415_restore_check
