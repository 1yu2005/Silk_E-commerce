// 作用：定义账号、文件、公共记录及配置/任务期限的数据模型；补充数据库约束随增量迁移交付。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 固定身份、岗位与账号状态，不提供动态岗位编辑。
enum SubjectType {
  EMPLOYEE
  CUSTOMER
}

enum EmployeeRole {
  SUPER_ADMIN
  MERCH_WAREHOUSE
  CUSTOMER_SERVICE
}

enum EmployeeStatus {
  ACTIVE
  DISABLED
}

enum CustomerStatus {
  NORMAL
  TRADE_RESTRICTED
  LOGIN_FROZEN
}

enum AuditActorType {
  EMPLOYEE
  CUSTOMER
  SYSTEM
}

model Employee {
  id                    String                    @id @default(uuid()) @db.Uuid
  username              String                    @unique @db.VarChar(32)
  displayName           String                    @map("display_name") @db.VarChar(40)
  passwordHash          String                    @map("password_hash")
  role                  EmployeeRole
  status                EmployeeStatus            @default(ACTIVE)
  mustChangePassword    Boolean                   @default(true) @map("must_change_password")
  tokenVersion          Int                       @default(0) @map("token_version")
  permissionVersion     Int                       @default(0) @map("permission_version")
  version               Int                       @default(0)
  lastLoginAt           DateTime?                 @map("last_login_at") @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              AuthSession[]
  extraPermissions      EmployeeExtraPermission[] @relation("PermissionOwner")
  grantedPermissions    EmployeeExtraPermission[] @relation("PermissionGrantor")
  audits                AuditLog[]
  uploadedFiles         FileAsset[]               @relation("EmployeeFileUploader")
  fileReferences        FileReference[]           @relation("EmployeeFileCreator")
  communications        Communication[]
  stateHistory          BusinessStateHistory[]    @relation("EmployeeStateActor")
  settingVersions       StoreSettingVersion[]
  assignedTasks         Task[]
  taskActions           TaskHistory[]             @relation("TaskHistoryActor")
  taskAssignmentsFrom   TaskHistory[]             @relation("TaskHistoryFromAssignee")
  taskAssignmentsTo     TaskHistory[]             @relation("TaskHistoryToAssignee")
  deadlineActions       DeadlineEvent[]
  customerStatusActions CustomerStatusHistory[]

  @@index([status, role])
  @@index([createdAt, id])
  @@map("employee")
}

model Customer {
  id             String                  @id @default(uuid()) @db.Uuid
  phone          String                  @unique @db.VarChar(11)
  passwordHash   String                  @map("password_hash")
  nickname       String                  @db.VarChar(40)
  status         CustomerStatus          @default(NORMAL)
  tokenVersion   Int                     @default(0) @map("token_version")
  statusVersion  Int                     @default(0) @map("status_version")
  lastLoginAt    DateTime?               @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions       AuthSession[]
  audits         AuditLog[]
  avatarAssetId  String?                 @map("avatar_asset_id") @db.Uuid
  avatarAsset    FileAsset?              @relation("CurrentCustomerAvatar", fields: [avatarAssetId], references: [id], onDelete: Restrict)
  uploadedFiles  FileAsset[]             @relation("CustomerFileUploader")
  fileReferences FileReference[]         @relation("CustomerFileCreator")
  stateHistory   BusinessStateHistory[]  @relation("CustomerStateActor")
  statusHistory  CustomerStatusHistory[]
  addresses      Address[]
  cartItems      CartItem[]

  @@index([status, createdAt, id])
  @@index([avatarAssetId])
  @@index([createdAt, id])
  @@map("customer")
}

// 互斥主体及时间约束由迁移中的 CHECK 保证。
model AuthSession {
  id           String      @id @default(uuid()) @db.Uuid
  subjectType  SubjectType @map("subject_type")
  employeeId   String?     @map("employee_id") @db.Uuid
  customerId   String?     @map("customer_id") @db.Uuid
  tokenVersion Int         @map("token_version")
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?     @map("revoke_reason") @db.VarChar(64)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  employee     Employee?   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([employeeId, expiresAt])
  @@index([customerId, expiresAt])
  @@index([expiresAt])
  @@map("auth_session")
}

model PermissionDefinition {
  code             String                    @id @db.VarChar(100)
  name             String                    @db.VarChar(80)
  description      String
  adminOnly        Boolean                   @map("admin_only")
  dependencies     Json
  rolePermissions  RolePermission[]
  extraPermissions EmployeeExtraPermission[]

  @@map("permission_definition")
}

model RolePermission {
  role           EmployeeRole
  permissionCode String               @map("permission_code") @db.VarChar(100)
  permission     PermissionDefinition @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([role, permissionCode])
  @@map("role_permission")
}

model EmployeeExtraPermission {
  employeeId     String               @map("employee_id") @db.Uuid
  permissionCode String               @map("permission_code") @db.VarChar(100)
  grantedById    String               @map("granted_by_id") @db.Uuid
  grantedAt      DateTime             @default(now()) @map("granted_at") @db.Timestamptz(3)
  employee       Employee             @relation("PermissionOwner", fields: [employeeId], references: [id], onDelete: Restrict)
  permission     PermissionDefinition @relation(fields: [permissionCode], references: [code], onDelete: Restrict)
  grantedBy      Employee             @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([employeeId, permissionCode])
  @@map("employee_extra_permission")
}

// 审计仅保存白名单差异，禁止写入密码、哈希和令牌。
model AuditLog {
  id              String         @id @default(uuid()) @db.Uuid
  actorType       AuditActorType @map("actor_type")
  actorEmployeeId String?        @map("actor_employee_id") @db.Uuid
  actorCustomerId String?        @map("actor_customer_id") @db.Uuid
  action          String         @db.VarChar(100)
  targetType      String         @map("target_type") @db.VarChar(80)
  targetId        String         @map("target_id") @db.VarChar(100)
  reason          String?        @db.VarChar(500)
  beforeData      Json?          @map("before_data")
  afterData       Json?          @map("after_data")
  requestId       String         @map("request_id") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actorEmployee   Employee?      @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  actorCustomer   Customer?      @relation(fields: [actorCustomerId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorEmployeeId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_log")
}

// 所有影响可用管理员集合的命令先锁定固定行，再锁员工主体。
model SystemGuard {
  key       String   @id @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("system_guard")
}

// 文件用途、生命周期和引用范围均由服务端控制，不接受客户端任意改写。
enum FilePurpose {
  CUSTOMER_AVATAR
  PRODUCT_IMAGE
  AFTER_SALE_EVIDENCE
  INVENTORY_EVIDENCE
  FULFILLMENT_EVIDENCE
  INSPECTION_EVIDENCE
  COMMUNICATION_EVIDENCE
}

enum FileAssetState {
  STAGED
  RETAINED
  PURGE_PENDING
  PURGED
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum FileOwnerType {
  HANDOVER_VERIFICATION
  SHIPMENT_EXCEPTION
  SHIPMENT_EXCEPTION_DECISION
  SHIPMENT_TRACKING_REVISION
  ORDER_ITEM
  STOCK_INCIDENT
  CUSTOMER_AVATAR
  PRODUCT
  AFTER_SALE_MATERIAL
  INVENTORY_ADJUSTMENT
  INVENTORY_SOURCE
  FULFILLMENT_CHECK
  RETURN_RECEIPT
  RETURN_INSPECTION
  COMMUNICATION
  OFFLINE_CASE
}

enum FileAudience {
  PUBLIC
  CUSTOMER_VISIBLE
  INTERNAL
}

enum CommunicationScopeType {
  ORDER
  AFTER_SALE
}

enum CommunicationChannel {
  PHONE
  EXTERNAL_MESSAGE
  IN_PERSON
  OTHER
}

enum BusinessAggregateType {
  INVENTORY_ADJUSTMENT
  PRODUCT
  ORDER
  FULFILLMENT
  AFTER_SALE
}

// 只保存受控存储的元数据；真实图片解码、路径检查和用途授权由文件服务负责。
model FileAsset {
  id                 String          @id @default(uuid()) @db.Uuid
  uploaderType       SubjectType     @map("uploader_type")
  uploaderEmployeeId String?         @map("uploader_employee_id") @db.Uuid
  uploaderCustomerId String?         @map("uploader_customer_id") @db.Uuid
  purpose            FilePurpose
  state              FileAssetState  @default(STAGED)
  visibility         FileVisibility  @default(PRIVATE)
  storageKey         String          @unique @map("storage_key") @db.VarChar(255)
  originalName       String          @map("original_name") @db.VarChar(200)
  mimeType           String          @map("mime_type") @db.VarChar(32)
  byteSize           Int             @map("byte_size")
  width              Int
  height             Int
  sha256             String          @db.Char(64)
  expiresAt          DateTime?       @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  purgeStartedAt     DateTime?       @map("purge_started_at") @db.Timestamptz(3)
  purgedAt           DateTime?       @map("purged_at") @db.Timestamptz(3)
  version            Int             @default(0)
  uploaderEmployee   Employee?       @relation("EmployeeFileUploader", fields: [uploaderEmployeeId], references: [id], onDelete: Restrict)
  uploaderCustomer   Customer?       @relation("CustomerFileUploader", fields: [uploaderCustomerId], references: [id], onDelete: Restrict)
  references         FileReference[]
  productImages      ProductImage[]
  currentAvatars     Customer[]      @relation("CurrentCustomerAvatar")

  @@index([state, expiresAt, id])
  @@index([uploaderCustomerId, state])
  @@index([uploaderEmployeeId, state])
  @@map("file_asset")
}

// ownerId是白名单业务类型的逻辑关联；绑定服务仍须在同事务验证真实业务及权限。
model FileReference {
  id                  String        @id @default(uuid()) @db.Uuid
  fileAssetId         String        @map("file_asset_id") @db.Uuid
  ownerType           FileOwnerType @map("owner_type")
  ownerId             String        @map("owner_id") @db.Uuid
  slot                String        @db.VarChar(50)
  audience            FileAudience
  createdByType       SubjectType   @map("created_by_type")
  createdByEmployeeId String?       @map("created_by_employee_id") @db.Uuid
  createdByCustomerId String?       @map("created_by_customer_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  fileAsset           FileAsset     @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  createdByEmployee   Employee?     @relation("EmployeeFileCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  createdByCustomer   Customer?     @relation("CustomerFileCreator", fields: [createdByCustomerId], references: [id], onDelete: Restrict)

  @@unique([fileAssetId, ownerType, ownerId, slot], map: "file_reference_asset_owner_slot_key")
  @@index([ownerType, ownerId])
  @@index([createdByEmployeeId])
  @@index([createdByCustomerId])
  @@map("file_reference")
}

// 沟通只追加；更正引用旧记录，公开说明与内部结果分开，业务模块建立前不开HTTP入口。
model Communication {
  id               String                 @id @default(uuid()) @db.Uuid
  scopeType        CommunicationScopeType @map("scope_type")
  scopeId          String                 @map("scope_id") @db.Uuid
  authorEmployeeId String                 @map("author_employee_id") @db.Uuid
  channel          CommunicationChannel
  occurredAt       DateTime               @map("occurred_at") @db.Timestamptz(3)
  result           String
  nextStep         String?                @map("next_step") @db.VarChar(1000)
  publicText       String?                @map("public_text") @db.VarChar(2000)
  correctsId       String?                @map("corrects_id") @db.Uuid
  correctionReason String?                @map("correction_reason") @db.VarChar(500)
  requestId        String                 @map("request_id") @db.VarChar(64)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  authorEmployee   Employee               @relation(fields: [authorEmployeeId], references: [id], onDelete: Restrict)
  corrects         Communication?         @relation("CommunicationCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections      Communication[]        @relation("CommunicationCorrection")

  @@index([scopeType, scopeId, createdAt, id])
  @@index([authorEmployeeId, createdAt])
  @@index([correctsId])
  @@map("communication")
}

// 不同状态维度分别追加历史；动作键去重不替代领域状态机、库存流水或支付事实。
model BusinessStateHistory {
  id              String                @id @default(uuid()) @db.Uuid
  aggregateType   BusinessAggregateType @map("aggregate_type")
  aggregateId     String                @map("aggregate_id") @db.Uuid
  dimension       String                @db.VarChar(50)
  commandKey      String                @map("command_key") @db.VarChar(150)
  fromState       String?               @map("from_state") @db.VarChar(80)
  toState         String                @map("to_state") @db.VarChar(80)
  actorType       AuditActorType        @map("actor_type")
  actorEmployeeId String?               @map("actor_employee_id") @db.Uuid
  actorCustomerId String?               @map("actor_customer_id") @db.Uuid
  reason          String?               @db.VarChar(500)
  publicText      String?               @map("public_text") @db.VarChar(2000)
  requestId       String                @map("request_id") @db.VarChar(64)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  actorEmployee   Employee?             @relation("EmployeeStateActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  actorCustomer   Customer?             @relation("CustomerStateActor", fields: [actorCustomerId], references: [id], onDelete: Restrict)

  @@unique([aggregateType, aggregateId, dimension, commandKey], map: "business_state_history_command_key")
  @@index([aggregateType, aggregateId, createdAt, id], map: "business_state_history_aggregate_time_idx")
  @@index([actorEmployeeId])
  @@index([actorCustomerId])
  @@map("business_state_history")
}

// 固定业务类型和阶段，不提供动态工作流；真实业务归属由后续领域适配器验证。
enum TaskBusinessType {
  INVENTORY_ADJUSTMENT
  ORDER
  AFTER_SALE
  OFFLINE_CASE
  CUSTODY_ARRANGEMENT
}

enum TaskStage {
  INVENTORY_POST
  INVENTORY_RECONCILE
  SHIPMENT_PROCESS
  HANDOVER_VERIFY
  PHYSICAL_VERIFY
  STOCK_EXCEPTION_VERIFY
  SHIPMENT_EXCEPTION_VERIFY
  CUSTOMER_CONTACT
  AFTER_SALE_REVIEW
  SUPPLEMENT_FOLLOW
  RETURN_FOLLOW
  RETURN_RECEIVE
  RETURN_INSPECT
  INSPECTION_EXCEPTION_CONTACT
  REFUND_PROCESS
  ADMIN_DISPUTE
  ADMIN_STOCK_REVIEW
  PROXY_INPUT
  OFFLINE_FOLLOW
  CUSTODY_EXECUTE
}

enum TaskStatus {
  OPEN
  CLAIMED
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum TaskHistoryAction {
  CREATED
  CLAIMED
  RELEASED
  TRANSFERRED
  QUALIFICATION_LOST
  SUSPENDED
  RESUMED
  COMPLETED
  CANCELLED
  DEADLINE_CHANGED
}

// 员工任务历史与系统触发记录；顾客动作仍由其真实业务记录保存顾客主体。
enum TaskActorType {
  EMPLOYEE
  SYSTEM
}

enum DeadlineEventType {
  OVERDUE
  EXTENDED
  DEADLINE_ASSIGNED
}

enum SchedulerRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL_FAILED
  FAILED
  ABANDONED
}

// 单店稳定行作为并发锁锚点；复合外键保证当前指针和版本号一致。
model StoreSettingHead {
  id               Int                  @id @default(1) @db.SmallInt
  currentVersionId String?              @map("current_version_id") @db.Uuid
  version          Int                  @default(0)
  currentVersion   StoreSettingVersion? @relation(fields: [currentVersionId, version], references: [id, versionNumber], onDelete: Restrict, onUpdate: Restrict)

  @@map("store_setting_head")
}

// 完整设置快照只追加；地址和电话无虚构默认值，初版由后续管理员命令创建。
model StoreSettingVersion {
  id                         String             @id @default(uuid()) @db.Uuid
  versionNumber              Int                @unique @map("version_number")
  createdByEmployeeId        String?            @map("created_by_employee_id") @db.Uuid
  reason                     String             @db.VarChar(500)
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  shippingFeeCents           Int                @map("shipping_fee_cents")
  freeShippingEnabled        Boolean            @map("free_shipping_enabled")
  freeShippingThresholdCents Int                @map("free_shipping_threshold_cents")
  returnReceiver             String             @map("return_receiver") @db.VarChar(40)
  returnPhone                String             @map("return_phone") @db.VarChar(30)
  returnProvince             String             @map("return_province") @db.VarChar(50)
  returnCity                 String             @map("return_city") @db.VarChar(50)
  returnDistrict             String             @map("return_district") @db.VarChar(50)
  returnDetail               String             @map("return_detail") @db.VarChar(200)
  servicePhone               String             @map("service_phone") @db.VarChar(30)
  serviceHours               String?            @map("service_hours") @db.VarChar(100)
  paymentMinutes             Int                @map("payment_minutes")
  autoReceiptDays            Int                @map("auto_receipt_days")
  afterSaleWindowDays        Int                @map("after_sale_window_days")
  reviewWorkdays             Int                @map("review_workdays")
  supplementDays             Int                @map("supplement_days")
  returnShipDays             Int                @map("return_ship_days")
  inspectionWorkdays         Int                @map("inspection_workdays")
  refundWorkdays             Int                @map("refund_workdays")
  createdByEmployee          Employee?          @relation(fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  heads                      StoreSettingHead[]
  tasks                      Task[]

  @@unique([id, versionNumber], map: "store_setting_version_id_number_key")
  @@index([createdAt, id])
  @@map("store_setting_version")
}

// 稳定阶段游标仲裁轮次；不使用无锁max(round)+1。
model TaskStageCursor {
  id           String           @id @default(uuid()) @db.Uuid
  businessType TaskBusinessType @map("business_type")
  businessId   String           @map("business_id") @db.Uuid
  stage        TaskStage
  lastRound    Int              @default(0) @map("last_round")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tasks        Task[]

  @@unique([businessType, businessId, stage], map: "task_stage_cursor_business_stage_key")
  @@unique([id, businessType, businessId, stage], map: "task_stage_cursor_id_business_stage_key")
  @@map("task_stage_cursor")
}

// 同业务同阶段最多一个有效任务的部分唯一索引由0004 SQL补充。
model Task {
  id                  String               @id @default(uuid()) @db.Uuid
  cursorId            String               @map("cursor_id") @db.Uuid
  businessType        TaskBusinessType     @map("business_type")
  businessId          String               @map("business_id") @db.Uuid
  stage               TaskStage
  round               Int
  entryKey            String               @map("entry_key") @db.VarChar(150)
  requiredPermissions Json                 @map("required_permissions")
  status              TaskStatus           @default(OPEN)
  assigneeId          String?              @map("assignee_id") @db.Uuid
  startedAt           DateTime             @map("started_at") @db.Timestamptz(3)
  originalDueAt       DateTime?            @map("original_due_at") @db.Timestamptz(3)
  dueAt               DateTime?            @map("due_at") @db.Timestamptz(3)
  settingsVersionId   String?              @map("settings_version_id") @db.Uuid
  ruleSnapshot        Json                 @map("rule_snapshot")
  everOverdue         Boolean              @default(false) @map("ever_overdue")
  firstOverdueAt      DateTime?            @map("first_overdue_at") @db.Timestamptz(3)
  closedAt            DateTime?            @map("closed_at") @db.Timestamptz(3)
  reassignNeeded      Boolean              @default(false) @map("reassign_needed")
  version             Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  cursor              TaskStageCursor      @relation(fields: [cursorId, businessType, businessId, stage], references: [id, businessType, businessId, stage], onDelete: Restrict, onUpdate: Restrict)
  assignee            Employee?            @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  settingsVersion     StoreSettingVersion? @relation(fields: [settingsVersionId], references: [id], onDelete: Restrict)
  history             TaskHistory[]
  deadlineEvents      DeadlineEvent[]
  schedulerFailures   SchedulerFailure[]

  @@unique([businessType, businessId, stage, round], map: "task_business_stage_round_key")
  @@unique([businessType, businessId, stage, entryKey], map: "task_business_stage_entry_key")
  @@index([assigneeId, status, dueAt, id], map: "task_assignee_status_due_idx")
  @@index([status, dueAt, id], map: "task_status_due_idx")
  @@index([reassignNeeded, status])
  @@index([businessType, businessId])
  @@index([settingsVersionId])
  @@map("task")
}

// 仅追加任务环节历史，不替代业务状态机或全店审计。
model TaskHistory {
  id              String            @id @default(uuid()) @db.Uuid
  taskId          String            @map("task_id") @db.Uuid
  action          TaskHistoryAction
  actorType       TaskActorType     @map("actor_type")
  actorEmployeeId String?           @map("actor_employee_id") @db.Uuid
  fromAssigneeId  String?           @map("from_assignee_id") @db.Uuid
  toAssigneeId    String?           @map("to_assignee_id") @db.Uuid
  beforeStatus    TaskStatus?       @map("before_status")
  afterStatus     TaskStatus        @map("after_status")
  reason          String?           @db.VarChar(500)
  commandKey      String            @map("command_key") @db.VarChar(150)
  requestId       String            @map("request_id") @db.VarChar(64)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorEmployee   Employee?         @relation("TaskHistoryActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  fromAssignee    Employee?         @relation("TaskHistoryFromAssignee", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssignee      Employee?         @relation("TaskHistoryToAssignee", fields: [toAssigneeId], references: [id], onDelete: Restrict)

  @@unique([taskId, action, commandKey], map: "task_history_command_key")
  @@index([taskId, createdAt, id], map: "task_history_time_idx")
  @@map("task_history")
}

// 逾期事实和延期分别保存；同一任务同一截止的OVERDUE另由部分唯一索引去重。
model DeadlineEvent {
  id              String            @id @default(uuid()) @db.Uuid
  taskId          String            @map("task_id") @db.Uuid
  eventType       DeadlineEventType @map("event_type")
  deadlineAt      DateTime          @map("deadline_at") @db.Timestamptz(3)
  newDueAt        DateTime?         @map("new_due_at") @db.Timestamptz(3)
  occurredAt      DateTime          @map("occurred_at") @db.Timestamptz(3)
  detectedAt      DateTime          @map("detected_at") @db.Timestamptz(3)
  actorType       TaskActorType     @map("actor_type")
  actorEmployeeId String?           @map("actor_employee_id") @db.Uuid
  reason          String?           @db.VarChar(500)
  commandKey      String            @map("command_key") @db.VarChar(150)
  requestId       String            @map("request_id") @db.VarChar(64)
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorEmployee   Employee?         @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@unique([taskId, eventType, commandKey], map: "deadline_event_command_key")
  @@index([taskId, occurredAt, id], map: "deadline_event_time_idx")
  @@map("deadline_event")
}

// 每轮调度的运行事实；进程崩溃遗留RUNNING由后续恢复扫描标ABANDONED。
model SchedulerRun {
  id           String             @id @default(uuid()) @db.Uuid
  jobName      String             @map("job_name") @db.VarChar(80)
  instanceId   String             @map("instance_id") @db.VarChar(100)
  startedAt    DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(3)
  status       SchedulerRunStatus @default(RUNNING)
  scannedCount Int                @default(0) @map("scanned_count")
  changedCount Int                @default(0) @map("changed_count")
  failedCount  Int                @default(0) @map("failed_count")
  requestId    String             @map("request_id") @db.VarChar(64)
  failures     SchedulerFailure[]

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("scheduler_run")
}

// 只允许脱敏错误摘要；诊断事务不冒充成功业务审计。
model SchedulerFailure {
  id               String       @id @default(uuid()) @db.Uuid
  runId            String       @map("run_id") @db.Uuid
  taskId           String?      @map("task_id") @db.Uuid
  errorCode        String       @map("error_code") @db.VarChar(80)
  sanitizedMessage String       @map("sanitized_message") @db.VarChar(500)
  occurredAt       DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  run              SchedulerRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  task             Task?        @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([runId, occurredAt])
  @@index([taskId])
  @@map("scheduler_failure")
}

// 商品只管理资料和销售资格；数量变更由后续库存记账模块负责。
enum ProductStatus {
  DRAFT
  ON_SALE
  OFF_SALE
}

enum InitialInventoryDraftStatus {
  EDITABLE
  CONVERTED
  VOID
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(50)
  nameKey   String     @map("name_key") @db.VarChar(100)
  iconKey   String?    @map("icon_key") @db.VarChar(50)
  sortOrder Int        @default(0) @map("sort_order")
  depth     Int        @db.SmallInt
  pathIds   String[]   @map("path_ids") @db.Uuid
  version   Int        @default(0)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId, sortOrder, id])
  @@map("category")
}

model Product {
  id             String                  @id @default(uuid()) @db.Uuid
  productCode    String                  @unique @map("product_code") @db.VarChar(64)
  name           String                  @db.VarChar(120)
  brand          String?                 @db.VarChar(80)
  description    String?                 @db.Text
  categoryId     String?                 @map("category_id") @db.Uuid
  status         ProductStatus           @default(DRAFT)
  archivedAt     DateTime?               @map("archived_at") @db.Timestamptz(3)
  paidSalesCount BigInt                  @default(0) @map("paid_sales_count")
  version        Int                     @default(0)
  createdById    String                  @map("created_by_id") @db.Uuid
  updatedById    String                  @map("updated_by_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  category       Category?               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  dimensions     ProductSpecDimension[]
  skus           Sku[]
  initialDrafts  InitialInventoryDraft[]

  @@index([status, archivedAt, createdAt, id])
  @@index([categoryId])
  @@map("product")
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  assetId   String    @map("asset_id") @db.Uuid
  slot      String    @db.VarChar(10)
  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset     FileAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([productId, slot, sortOrder])
  @@unique([productId, slot, assetId])
  @@map("product_image")
}

model ProductSpecDimension {
  id        String             @id @default(uuid()) @db.Uuid
  productId String             @map("product_id") @db.Uuid
  name      String             @db.VarChar(30)
  nameKey   String             @map("name_key") @db.VarChar(100)
  sortOrder Int                @map("sort_order")
  retiredAt DateTime?          @map("retired_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  values    ProductSpecValue[]
  choices   SkuSpecChoice[]

  @@map("product_spec_dimension")
}

model ProductSpecValue {
  id          String               @id @default(uuid()) @db.Uuid
  dimensionId String               @map("dimension_id") @db.Uuid
  name        String               @db.VarChar(30)
  nameKey     String               @map("name_key") @db.VarChar(100)
  sortOrder   Int                  @map("sort_order")
  retiredAt   DateTime?            @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  dimension   ProductSpecDimension @relation(fields: [dimensionId], references: [id], onDelete: Restrict)
  choices     SkuSpecChoice[]

  @@unique([id, dimensionId])
  @@map("product_spec_value")
}

model Sku {
  id                   String                      @id @default(uuid()) @db.Uuid
  productId            String                      @map("product_id") @db.Uuid
  code                 String                      @unique @db.VarChar(64)
  combinationSignature String                      @map("combination_signature") @db.VarChar(64)
  priceCents           Int?                        @map("price_cents")
  costCents            Int?                        @map("cost_cents")
  enabled              Boolean                     @default(true)
  retiredAt            DateTime?                   @map("retired_at") @db.Timestamptz(3)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  product              Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  choices              SkuSpecChoice[]
  balance              InventoryBalance?
  draftLines           InitialInventoryDraftLine[]
  cartItems            CartItem[]

  @@unique([productId, combinationSignature])
  @@map("sku")
}

model SkuSpecChoice {
  skuId       String               @map("sku_id") @db.Uuid
  dimensionId String               @map("dimension_id") @db.Uuid
  valueId     String               @map("value_id") @db.Uuid
  sku         Sku                  @relation(fields: [skuId], references: [id], onDelete: Restrict)
  dimension   ProductSpecDimension @relation(fields: [dimensionId], references: [id], onDelete: Restrict)
  value       ProductSpecValue     @relation(fields: [valueId, dimensionId], references: [id, dimensionId], onDelete: Restrict)

  @@id([skuId, dimensionId])
  @@map("sku_spec_choice")
}

model InventoryBalance {
  skuId            String   @id @map("sku_id") @db.Uuid
  available        Int      @default(0)
  reserved         Int      @default(0)
  warningThreshold Int      @default(10) @map("warning_threshold")
  purchaseBlocked  Boolean  @default(false) @map("purchase_blocked")
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sku              Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("inventory_balance")
}

model InitialInventoryDraft {
  id            String                      @id @default(uuid()) @db.Uuid
  productId     String                      @map("product_id") @db.Uuid
  conversionKey String                      @unique @default(uuid()) @map("conversion_key") @db.Uuid
  adjustmentId  String?                     @unique @map("adjustment_id") @db.Uuid
  status        InitialInventoryDraftStatus @default(EDITABLE)
  version       Int                         @default(0)
  createdById   String                      @map("created_by_id") @db.Uuid
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  product       Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines         InitialInventoryDraftLine[]

  @@map("initial_inventory_draft")
}

// 库存来源和登记均保留历史身份；外键及跨字段约束见0006，不提供物理删除命令。
enum InventorySourceType {
  RECEIPT
  LOSS
}

enum InventoryAdjustmentType {
  INITIALIZATION
  ARRIVAL
  AVAILABLE_LOSS
  CORRECTION
}

enum InventoryAdjustmentStatus {
  PENDING
  POSTED
  VOID
}

model InventorySource {
  id                  String              @id @default(uuid()) @db.Uuid
  sourceType          InventorySourceType @map("source_type")
  namespace           String              @db.VarChar(80)
  reference           String              @db.VarChar(100)
  normalizedReference String              @map("normalized_reference") @db.VarChar(150)
  note                String?             @db.VarChar(2000)
  version             Int                 @default(0)
  createdById         String              @map("created_by_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([namespace, normalizedReference])
  @@map("inventory_source")
}

model InventorySourceLine {
  id                String   @id @default(uuid()) @db.Uuid
  sourceId          String   @map("source_id") @db.Uuid
  lineKey           String   @map("line_key") @db.VarChar(64)
  skuId             String   @map("sku_id") @db.Uuid
  verifiedQuantity  Int      @map("verified_quantity")
  netPostedQuantity Int      @default(0) @map("net_posted_quantity")
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([sourceId, lineKey])
  @@unique([id, skuId])
  @@index([skuId])
  @@map("inventory_source_line")
}

model InventoryAdjustment {
  id                    String                    @id @default(uuid()) @db.Uuid
  number                String                    @unique @db.VarChar(64)
  type                  InventoryAdjustmentType
  status                InventoryAdjustmentStatus @default(PENDING)
  reason                String                    @db.VarChar(500)
  evidenceNote          String?                   @map("evidence_note") @db.VarChar(2000)
  createdById           String                    @map("created_by_id") @db.Uuid
  postedById            String?                   @map("posted_by_id") @db.Uuid
  voidedById            String?                   @map("voided_by_id") @db.Uuid
  postedAt              DateTime?                 @map("posted_at") @db.Timestamptz(3)
  voidedAt              DateTime?                 @map("voided_at") @db.Timestamptz(3)
  version               Int                       @default(0)
  conversionKey         String?                   @unique @map("conversion_key") @db.Uuid
  conversionFingerprint String?                   @map("conversion_fingerprint") @db.Char(64)
  conversionSnapshot    Json?                     @map("conversion_snapshot")
  checkRequired         Boolean                   @default(false) @map("check_required")
  checkReasonCode       String?                   @map("check_reason_code") @db.VarChar(80)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, type])
  @@index([status, createdAt, id])
  @@map("inventory_adjustment")
}

model InventoryAdjustmentLine {
  id           String                  @id @default(uuid()) @db.Uuid
  adjustmentId String                  @map("adjustment_id") @db.Uuid
  type         InventoryAdjustmentType
  skuId        String                  @map("sku_id") @db.Uuid
  sourceLineId String                  @map("source_line_id") @db.Uuid
  batchKey     String?                 @map("batch_key") @db.VarChar(80)
  quantity     Int?
  signedDeltaA Int?                    @map("signed_delta_a")
  rootLineId   String?                 @map("root_line_id") @db.Uuid

  @@index([adjustmentId])
  @@index([rootLineId])
  @@index([skuId])
  @@map("inventory_adjustment_line")
}

model InventoryReceiptBatch {
  id                   String   @id @default(uuid()) @db.Uuid
  sourceLineId         String   @map("source_line_id") @db.Uuid
  batchKey             String   @map("batch_key") @db.VarChar(80)
  rootAdjustmentLineId String   @unique @map("root_adjustment_line_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sourceLineId, batchKey])
  @@map("inventory_receipt_batch")
}

model InventoryAction {
  id                 String         @id @default(uuid()) @db.Uuid
  businessType       String         @map("business_type") @db.VarChar(40)
  businessId         String         @map("business_id") @db.Uuid
  actionType         String         @map("action_type") @db.VarChar(50)
  actionKey          String         @unique @map("action_key") @db.VarChar(180)
  requestFingerprint String         @map("request_fingerprint") @db.Char(64)
  adjustmentId       String?        @unique @map("adjustment_id") @db.Uuid
  resultSummary      Json           @map("result_summary")
  actorType          AuditActorType @map("actor_type")
  actorEmployeeId    String?        @map("actor_employee_id") @db.Uuid
  actorCustomerId    String?        @map("actor_customer_id") @db.Uuid
  requestId          String         @map("request_id") @db.VarChar(64)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([businessType, businessId])
  @@map("inventory_action")
}

model InventoryLedger {
  id                   String         @id @default(uuid()) @db.Uuid
  actionId             String         @map("action_id") @db.Uuid
  skuId                String         @map("sku_id") @db.Uuid
  sequence             Int
  eventType            String         @map("event_type") @db.VarChar(50)
  beforeA              Int            @map("before_a")
  beforeR              Int            @map("before_r")
  afterA               Int            @map("after_a")
  afterR               Int            @map("after_r")
  deltaA               Int            @map("delta_a")
  deltaR               Int            @map("delta_r")
  quantityReleased     Int?           @map("quantity_released")
  quantityDamaged      Int?           @map("quantity_damaged")
  sourceLineId         String?        @map("source_line_id") @db.Uuid
  rootAdjustmentLineId String?        @map("root_adjustment_line_id") @db.Uuid
  businessType         String         @map("business_type") @db.VarChar(40)
  businessId           String         @map("business_id") @db.Uuid
  businessNumber       String         @map("business_number") @db.VarChar(64)
  reason               String         @db.VarChar(500)
  actorType            AuditActorType @map("actor_type")
  actorEmployeeId      String?        @map("actor_employee_id") @db.Uuid
  actorCustomerId      String?        @map("actor_customer_id") @db.Uuid
  requestId            String         @map("request_id") @db.VarChar(64)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actionId, skuId, sequence])
  @@index([skuId, createdAt, id])
  @@index([businessType, businessId])
  @@index([eventType, createdAt])
  @@index([sourceLineId])
  @@map("inventory_ledger")
}

model InventoryPurchaseBlock {
  id                  String    @id @default(uuid()) @db.Uuid
  skuId               String    @map("sku_id") @db.Uuid
  sourceType          String    @map("source_type") @db.VarChar(40)
  sourceId            String    @map("source_id") @db.Uuid
  reasonCode          String    @map("reason_code") @db.VarChar(80)
  active              Boolean   @default(true)
  createdByEmployeeId String?   @map("created_by_employee_id") @db.Uuid
  releasedAt          DateTime? @map("released_at") @db.Timestamptz(3)
  version             Int       @default(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([skuId, active])
  @@map("inventory_purchase_block")
}

model InitialInventoryDraftLine {
  draftId  String                @map("draft_id") @db.Uuid
  skuId    String                @map("sku_id") @db.Uuid
  quantity Int
  draft    InitialInventoryDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  sku      Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@id([draftId, skuId])
  @@map("initial_inventory_draft_line")
}

// 顾客状态历史独立于商品/订单状态，状态命令、会话和审计共同提交。
model CustomerStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  fromStatus      CustomerStatus @map("from_status")
  toStatus        CustomerStatus @map("to_status")
  fromVersion     Int            @map("from_version")
  toVersion       Int            @map("to_version")
  reason          String         @db.VarChar(500)
  actorEmployeeId String         @map("actor_employee_id") @db.Uuid
  requestId       String         @map("request_id") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actorEmployee   Employee       @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@unique([customerId, toVersion])
  @@index([customerId, createdAt, id])
  @@map("customer_status_history")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  receiver   String   @db.VarChar(40)
  phone      String   @db.VarChar(30)
  province   String   @db.VarChar(50)
  city       String   @db.VarChar(50)
  district   String   @db.VarChar(50)
  detail     String   @db.VarChar(200)
  isDefault  Boolean  @default(false) @map("is_default")
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, isDefault, createdAt, id])
  @@map("address")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  quantity   Int
  selected   Boolean  @default(true)
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([customerId, skuId])
  @@index([customerId, updatedAt, id])
  @@map("cart_item")
}

// 合并板块8＋9：旧实体外键在增量SQL中维护，业务快照不回查现值。
model CheckoutQuote {
  id                  String              @id @default(uuid()) @db.Uuid
  customerId          String              @map("customer_id") @db.Uuid
  addressIdSnapshot   String              @map("address_id_snapshot") @db.Uuid
  addressVersion      Int                 @map("address_version")
  addressSnapshot     Json                @map("address_snapshot")
  settingVersionId    String              @map("setting_version_id") @db.Uuid
  pricingRuleSnapshot Json                @map("pricing_rule_snapshot")
  goodsAmountCents    Int                 @map("goods_amount_cents")
  shippingFeeCents    Int                 @map("shipping_fee_cents")
  payableCents        Int                 @map("payable_cents")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt           DateTime            @map("expires_at") @db.Timestamptz(3)
  items               CheckoutQuoteItem[]
  orders              Order[]

  @@index([customerId, createdAt])
  @@map("checkout_quote")
}

model CheckoutQuoteItem {
  id                 String        @id @default(uuid()) @db.Uuid
  quoteId            String        @map("quote_id") @db.Uuid
  cartItemIdSnapshot String        @map("cart_item_id_snapshot") @db.Uuid
  skuId              String        @map("sku_id") @db.Uuid
  quantity           Int
  unitPriceCents     Int           @map("unit_price_cents")
  lineAmountCents    Int           @map("line_amount_cents")
  quote              CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([quoteId, skuId])
  @@unique([quoteId, cartItemIdSnapshot])
  @@map("checkout_quote_item")
}

model Order {
  id                   String              @id @default(uuid()) @db.Uuid
  number               String              @unique @db.VarChar(64)
  customerId           String              @map("customer_id") @db.Uuid
  quoteId              String              @map("quote_id") @db.Uuid
  sourceAddressId      String?             @map("source_address_id") @db.Uuid
  status               String              @default("WAIT_PAYMENT") @db.VarChar(30)
  fulfillmentStage     String              @default("UNCLAIMED") @map("fulfillment_stage") @db.VarChar(30)
  goodsAmountCents     Int                 @map("goods_amount_cents")
  shippingFeeCents     Int                 @map("shipping_fee_cents")
  payableCents         Int                 @map("payable_cents")
  receiver             String              @db.VarChar(40)
  phone                String              @db.VarChar(30)
  province             String              @db.VarChar(50)
  city                 String              @db.VarChar(50)
  district             String              @db.VarChar(50)
  detail               String              @db.VarChar(200)
  shippingRuleSnapshot Json                @map("shipping_rule_snapshot")
  paymentRuleSnapshot  Json                @map("payment_rule_snapshot")
  settingVersionId     String              @map("setting_version_id") @db.Uuid
  paymentDeadline      DateTime            @map("payment_deadline") @db.Timestamptz(3)
  paidAt               DateTime?           @map("paid_at") @db.Timestamptz(3)
  closedAt             DateTime?           @map("closed_at") @db.Timestamptz(3)
  closeReasonCode      String?             @map("close_reason_code") @db.VarChar(40)
  closeReason          String?             @map("close_reason") @db.VarChar(500)
  closedByType         String?             @map("closed_by_type") @db.VarChar(20)
  closedById           String?             @map("closed_by_id") @db.Uuid
