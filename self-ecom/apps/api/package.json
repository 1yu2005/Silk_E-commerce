{
  "name": "@shop/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "openapi:export": "tsx scripts/openapi.ts",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts prisma.config.ts",
    "test": "vitest run",
    "db:generate": "tsx scripts/database.ts generate",
    "db:migrate:dev": "tsx scripts/database.ts migrate-dev",
    "db:migrate:deploy": "tsx scripts/database.ts migrate-deploy",
    "db:migrate:status": "tsx scripts/database.ts migrate-status",
    "db:test:prepare": "tsx scripts/database.ts prepare-test",
    "test:integration": "tsx scripts/integration.ts",
    "db:seed:permissions": "tsx scripts/seed-permissions.ts",
    "db:seed:permissions:test": "tsx scripts/seed-permissions.ts --test",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:admin:test": "tsx scripts/seed-admin.ts --test"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@shop/shared": "workspace:*",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@types/bcrypt": "6.0.0",
    "@types/pg": "8.23.1",
    "vitest": "5.1.0"
  }
}
